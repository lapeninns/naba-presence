#!/bin/sh
# Opt-in with pnpm hooks:install. Set NABA_PRE_PUSH_VERIFY=1 to also run the
# full quick checks on the current checkout. The authoritative gate is lci.
set -eu

if [ "${SKIP_VERIFY:-}" = 1 ]; then
  echo "pre-push: SKIP_VERIFY=1, skipping local checks"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
# Stop checks and their scratch repositories inheriting the caller's index.
for git_local_env_name in $(git rev-parse --local-env-vars); do
  unset "$git_local_env_name"
done

# Every path must be inert documentation for the optional quick check to skip.
docs_only() {
  while IFS= read -r path; do
    case "$path" in
      AGENTS.md | */AGENTS.md) return 1 ;;
      .github/* | scripts/* | supabase/*) return 1 ;;
      README.md | docs/architecture.md | docs/ci.md | docs/frontend-backend-feature-map.md | docs/release/* | docs/runbook.md) return 1 ;;
      docs/* | *.md) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

scan() {
  if command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: scanning pushed commits ($1)"
    gitleaks git --no-banner --redact --log-opts="$1" .
  else
    echo "pre-push: gitleaks unavailable, local scan skipped. The release gate requires it."
  fi
}

verify=false
seen=false
pushed=false
if [ ! -t 0 ]; then
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    seen=true
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    pushed=true
    to=$(git rev-parse --verify "$local_sha^{commit}")
    case "$remote_sha" in
      *[!0]*) from=$(git rev-parse --verify "$remote_sha^{commit}" 2>/dev/null || true) ;;
      *) from=$(git merge-base origin/main "$to" 2>/dev/null || true) ;;
    esac
    if [ -z "$from" ]; then
      # Unknown history: scan all reachable commits of the pushed ref.
      scan "$to"
      verify=true
    else
      scan "$from..$to"
      if ! changed=$(git diff --name-only --no-renames "$from" "$to") ||
        ! printf '%s\n' "$changed" | docs_only; then
        verify=true
      fi
    fi
  done
fi

if [ "$seen" = false ]; then
  # Manual invocation has no Git input. Check the current checkout.
  scan HEAD
  verify=true
elif [ "$pushed" = false ]; then
  echo "pre-push: push only deletes refs"
elif [ "$verify" = false ]; then
  echo "pre-push: push changes only documentation"
fi

if [ "${NABA_PRE_PUSH_VERIFY:-}" = 1 ] && [ "$verify" = true ]; then
  pnpm verify
fi

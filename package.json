{
  "name": "nabapresence",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "start:scheduler": "node scripts/scheduler.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:runtime-role": "node scripts/db-create-runtime-role.mjs",
    "db:status": "node scripts/db-status.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "test": "vitest run",
    "test:a11y": "node scripts/run-test-command.mjs e2e pnpm exec playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "node scripts/run-test-command.mjs e2e pnpm exec playwright test",
    "test:integration": "node scripts/run-test-command.mjs integration pnpm exec vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@shadcn/react": "^0.2.1",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tinyld": "^1.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@next/env": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "2.106.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }

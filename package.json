{
  "name": "nabapresence",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "start:scheduler": "node scripts/scheduler.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:runtime-role": "node scripts/db-create-runtime-role.mjs",
    "db:status": "node scripts/db-status.mjs",
    "release:promote": "node scripts/release/promote.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "verify:release": "node scripts/release/verify-local.mjs",
    "ops:revoke-support-sessions": "node scripts/revoke-support-sessions.mjs",
    "ops:mfa-recover": "node scripts/mfa-recover.mjs",
    "ops:pause": "node scripts/ops-pause.mjs",
    "ops:readiness": "node scripts/ops/readiness-probe.mjs",
    "billing:catalog": "node scripts/billing-catalog.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "test": "vitest run --project unit --project components",
    "audit:mobile": "node tests/visual/mobile-audit.mjs",
    "test:a11y": "node scripts/run-test-command.mjs e2e pnpm exec playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "node scripts/run-test-command.mjs e2e pnpm exec playwright test",
    "test:e2e:touch": "node scripts/run-test-command.mjs e2e pnpm exec playwright test --project=touch-390",
    "test:integration": "node scripts/run-test-command.mjs integration pnpm exec vitest run --project integration",
    "test:watch": "vitest --project unit --project components",
    "lint": "eslint --max-warnings 0",
    "lint:workflows": "actionlint && zizmor --offline .github/",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "node scripts/format-changed.mjs --check",
    "format:changed": "node scripts/format-changed.mjs --write",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:design --ratchet",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "^3.6.0",
    "tinyld": "^1.3.4",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.16.0",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}

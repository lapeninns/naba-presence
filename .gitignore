# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
# e2e runner output (report, artifacts, replay cache, app log)
/.e2e/
/test-results/

# local OMO state and QA evidence; authored plans are archived under docs/archive
/.omo/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (staged scripts, build output, machine state)
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules

# local pnpm content-addressable store
/.pnpm-store/

# local git worktrees
/.worktrees/
.vercel

# Cursor/OMO codegraph symlink (dangling targets break `next build`)
.codegraph

# local Supabase CLI state (start-secrets holds local service keys)
/supabase/.temp/

# design-tool provenance (machine-local, not a build input)
/.taste/

# superpowers brainstorm scratch state (session logs and a local tool token;
# never a build input, and it put a key into history once already)
/.superpowers/

# A package-manager cache written into the repo when HOME points here.
/Library/

# Local release-gate receipts (pnpm verify:release). Running the gate must not
# dirty the checkout promotion requires clean; promotion pins the one it cites
# by sha256 and commits a copy beside its receipt. See
# docs/release/receipts/README.md.
/docs/release/receipts/local/

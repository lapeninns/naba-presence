# Runtime connections MUST use a non-superuser member of naba_app_runtime
# (create locally with: pnpm db:runtime-role). Migrations use the admin URL.
DATABASE_URL=postgresql://naba_test_runtime:naba_test_runtime@127.0.0.1:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application/session security. Generate independent random values.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-16-random-characters
SUPPORT_IMPERSONATION_SECRET=

# Application identity. Supabase Auth owns passwords, email verification, and
# recovery; NabaPresence exchanges a verified identity for its own opaque
# database-backed session. Use the project URL and publishable/anon key.
PASSWORD_AUTH_ENABLED=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
AUTH_PROVIDER_TIMEOUT_MS=10000

# OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL_DRAFT=gpt-5-mini
OPENAI_MODEL_VERIFY=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=30000

# Google OAuth and Business Profile APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=replace-with-at-least-16-random-characters
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLACES_API_KEY=
GOOGLE_REQUESTS_PER_SECOND=8
GOOGLE_TIMEOUT_MS=15000
GOOGLE_MUTATION_TIMEOUT_MS=20000

# Google Business Profile capability flags. Product surfaces default on.
# GBP_MEDIA_ENABLED / GBP_LODGING_ENABLED / ACTIONS_CENTER_ENABLED are unused
# no-ops kept for deploy compatibility (writes use PUBLISH_ENABLED).
GBP_PERFORMANCE_ENABLED=true
GBP_KEYWORDS_ENABLED=true
KEYWORD_INTERVAL_SECONDS=86400
PERFORMANCE_INTERVAL_SECONDS=21600
GBP_POSTS_ENABLED=true
GBP_MEDIA_ENABLED=true
GBP_FOOD_MENUS_ENABLED=true
GBP_PLACE_ACTIONS_ENABLED=true
GBP_PROFILE_WRITES_ENABLED=true
# Google import review: stages Google-side profile/menu changes as suggestions
# a human decides on. Kill switch for raising, refreshing, and deciding.
IMPORT_REVIEW_ENABLED=true
GBP_LODGING_ENABLED=false
PRESENCE_RESOURCE_RECONCILE_INTERVAL_SECONDS=900
ACTIONS_CENTER_ENABLED=false

# Operational rollback switches.
DRAFTS_ENABLED=true
PUBLISH_ENABLED=true
SYNC_ENABLED=true
WEBHOOKS_ENABLED=true

# Local Docker only. Auto-provisions a local owner session when NEXTAUTH_URL
# points at localhost. Never enable this on a public deployment.
LOCAL_BOOTSTRAP_ENABLED=false

# OpenTelemetry. Point this at an OTLP collector in self-hosted deployments.
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_OTEL_VERBOSE=0

# Separate scheduler process (`pnpm start:scheduler`).
SCHEDULER_BASE_URL=http://127.0.0.1:3000
RECONCILE_INTERVAL_SECONDS=900
RETENTION_INTERVAL_SECONDS=86400

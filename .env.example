# Production (Vercel) must set, at minimum: DATABASE_URL, DIRECT_DATABASE_URL,
# NEXTAUTH_URL, NEXTAUTH_SECRET, TOKEN_ENCRYPTION_KEY, CRON_SECRET,
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, OPENAI_API_KEY, and either the Pub/Sub OIDC pair or
# WEBHOOKS_ENABLED=false. Startup refuses to boot without them; see
# docs/runbook.md, "Production database".

# Runtime connections MUST use a non-superuser member of naba_app_runtime
# (create locally with: pnpm db:runtime-role). Migrations use the admin URL.
# Hosted: both URLs go through the Supabase SESSION pooler (port 5432), never
# the transaction pooler (6543): the scheduler leases and the Google refresh
# lock are session advisory locks.
DATABASE_URL=postgresql://naba_test_runtime:naba_test_runtime@127.0.0.1:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application/session security. Generate independent random values.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Key rotation (docs/runbook.md, "Rotating the token encryption key"). Leave
# empty until a rotation starts: comma-separated, the first entry encrypts,
# every entry (and TOKEN_ENCRYPTION_KEY) decrypts.
TOKEN_ENCRYPTION_KEYS=
# Signs the Google OAuth state cookie; empty falls back to NEXTAUTH_SECRET.
# After setting it, leave OAUTH_STATE_ACCEPT_LEGACY=true for one deploy so
# consents in flight still verify, then set it to false.
OAUTH_STATE_SECRET=
OAUTH_STATE_ACCEPT_LEGACY=true
CRON_SECRET=replace-with-at-least-16-random-characters
SUPPORT_IMPERSONATION_SECRET=

# Application identity. Supabase Auth owns passwords, email verification, and
# recovery; NabaPresence exchanges a verified identity for its own opaque
# database-backed session. Use the project URL and publishable/anon key.
PASSWORD_AUTH_ENABLED=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
AUTH_PROVIDER_TIMEOUT_MS=10000

# OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL_DRAFT=gpt-5-mini
OPENAI_MODEL_VERIFY=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=30000

# Google OAuth and Business Profile APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=replace-with-at-least-16-random-characters
# These two are set together or not at all. The audience is a caller-chosen
# claim in a Google-issued ID token, not a secret, so the audience without the
# service-account pin authenticates nobody: startup safety refuses the pair,
# and the push endpoint answers 503.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLACES_API_KEY=
GOOGLE_REQUESTS_PER_SECOND=8
GOOGLE_TIMEOUT_MS=15000
GOOGLE_MUTATION_TIMEOUT_MS=20000
# Fleet-wide Google request budget, shared by every instance through Postgres.
# Business Profile allows 300 requests per minute per API and 10 edits per
# minute per profile (cannot be raised); these leave headroom under both.
GOOGLE_RATE_BUDGET_ENABLED=true
GOOGLE_API_REQUESTS_PER_MINUTE=240
GOOGLE_LOCATION_EDITS_PER_MINUTE=8

# Google Business Profile capability flags. Product surfaces default on.
# Each write flag gates its surface's Google mutations together with
# PUBLISH_ENABLED; GBP_PERFORMANCE_ENABLED / GBP_KEYWORDS_ENABLED gate
# ingestion. Disabled surfaces stay visible with a paused-write notice.
# The scheduler does not read these; RETENTION_ENABLED is the only flag it
# consults. It keeps calling the ingestion routes on their interval, and a
# paused flag answers 503 sync_paused per organisation, which the cron walk
# isolates as a per-tenant failure and logs. Expect that log noise for as long
# as either flag is off; nothing is dropped or re-armed by it.
GBP_PERFORMANCE_ENABLED=true
GBP_KEYWORDS_ENABLED=true
KEYWORD_INTERVAL_SECONDS=86400
PERFORMANCE_INTERVAL_SECONDS=21600
GBP_POSTS_ENABLED=true
GBP_MEDIA_ENABLED=true
GBP_FOOD_MENUS_ENABLED=true
GBP_PLACE_ACTIONS_ENABLED=true
GBP_PROFILE_WRITES_ENABLED=true
# Google import review: stages Google-side profile/menu changes as suggestions
# a human decides on. Kill switch for raising, refreshing, and deciding.
IMPORT_REVIEW_ENABLED=true
PRESENCE_RESOURCE_RECONCILE_INTERVAL_SECONDS=900

# Operational notifications: reconnect needed, stale listings, low-rated
# reviews, stale cron heartbeats. Incidents and in-app banners work without a
# provider; email needs EMAIL_PROVIDER=resend plus a key and a verified
# sender. OPS_ALERT_EMAILS receives infrastructure alerts (comma-separated).
NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_BASE_URL=https://api.resend.com
OPS_ALERT_EMAILS=
LISTING_STALE_AFTER_HOURS=6

# Platform sign-in lifetime, independent of the Google connection: a session
# ends after SESSION_IDLE_DAYS without use and SESSION_ABSOLUTE_DAYS after
# sign-in regardless. Background sync never depends on a session.
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=90

# Google Cross-Account Protection (RISC) receiver at
# /api/webhooks/google/risc. Receiving needs registration with Google
# (docs/runbook.md, "RISC"); the endpoint rejects anything unsigned.
RISC_ENABLED=true

# Operational rollback switches. Each is parsed once per process, so changing
# one needs a restart of both the web and scheduler processes; see the
# kill-switch table in docs/runbook.md for what each one stops.
DRAFTS_ENABLED=true
PUBLISH_ENABLED=true
SYNC_ENABLED=true
WEBHOOKS_ENABLED=true
# The background runner. Off, it claims nothing at all; PUBLISH_ENABLED and
# SYNC_ENABLED additionally decide which job kinds it may claim.
JOBS_ENABLED=true
# Degraded mode for an AI provider incident: off, verification runs its
# deterministic checks alone and a hand-written reply is still saved.
SEMANTIC_VERIFY_ENABLED=true
# RETENTION_ENABLED stops the sweep entirely (503 retention_paused), and the
# scheduler reads it too, so a paused deployment registers no retention tick
# and logs no failing one; RETENTION_DELETES_ENABLED stops only the
# irreversible deletes, so redaction of expired provider content keeps meeting
# its obligation.
RETENTION_ENABLED=true
RETENTION_DELETES_ENABLED=true

# Local development only. Auto-provisions a local owner session when
# NEXTAUTH_URL points at localhost. Never enable this on a public deployment.
LOCAL_BOOTSTRAP_ENABLED=false

# The /design-system route: internal accessibility and contrast evidence, not a
# product surface. Left blank it defaults on outside production and off in it,
# which is what you want either side. Set it to true only where a production
# build must serve the page, as the e2e harness does.
DESIGN_SYSTEM_EVIDENCE_ENABLED=

# OpenTelemetry. Point this at an OTLP collector in self-hosted deployments.
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_OTEL_VERBOSE=0

# Separate scheduler process (`pnpm start:scheduler`). It walks a cursor over
# every tenant for each loop and aborts a page at 55s. Seven loops run; the
# four intervals below plus PERFORMANCE_INTERVAL_SECONDS,
# KEYWORD_INTERVAL_SECONDS and PRESENCE_RESOURCE_RECONCILE_INTERVAL_SECONDS
# above set their periods.
SCHEDULER_BASE_URL=http://127.0.0.1:3000
RECONCILE_INTERVAL_SECONDS=900
RETENTION_INTERVAL_SECONDS=86400
SWEEP_INTERVAL_SECONDS=86400
JOBS_INTERVAL_SECONDS=60

# Per-page time budgets for the cursor-walking cron routes. Keep each below
# the scheduler's 55s abort: a page that runs out of budget returns the
# organisations it has already committed plus a nextCursor, whereas a page cut
# off by the abort commits on the server with no cursor reaching the caller,
# so the scheduler resumes from the last cursor it was given and repeats that
# page. /api/sync/sweep has no budget of its own; its cost is bounded by the
# one-organisation, five-page request the scheduler sends.
RECONCILE_BUDGET_MS=45000
RETENTION_BUDGET_MS=45000
PERFORMANCE_BUDGET_MS=45000
KEYWORDS_BUDGET_MS=45000
PRESENCE_RESOURCE_BUDGET_MS=45000

# Job runner batching. One tick claims JOBS_BATCH_SIZE due items in global
# due order, taking at most JOBS_PER_ORGANISATION from any one tenant, and
# runs JOBS_CONCURRENCY of them at a time. Concurrency is additionally
# bounded by DATABASE_POOL_MAX and, for Google work, by
# GOOGLE_REQUESTS_PER_SECOND.
DATABASE_POOL_MAX=10
JOBS_BATCH_SIZE=25
JOBS_CONCURRENCY=4
JOBS_PER_ORGANISATION=3
